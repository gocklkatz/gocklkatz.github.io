---
import { site } from "../data/site";
import { caseStudy } from "../data/case-study";

const onHome = Astro.url.pathname === "/" || Astro.url.pathname === "";
const section = (id: string) => (onHome ? `#${id}` : `/#${id}`);
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/">
      <span class="brand__name">{site.company}</span>
      <span class="brand__tagline">{site.tagline}</span>
    </a>
    <nav class="nav" aria-label="Primary">
      <a href={section("services")}>Services</a>
      <a href={section("proof")}>Proof</a>
      <a href={caseStudy.path}>Case study</a>
      <a href={section("showcase")}>Showcase</a>
      <a href={section("demos")}>Demos</a>
      <a href={section("contact")}>Contact</a>
    </nav>
  </div>
</header>
