---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DemoCard from "../components/DemoCard.astro";
import { demos } from "../data/demos";
import {
  site,
  audience,
  proof,
  teaser,
  demosSection,
} from "../data/site";
import { services, servicesIntro } from "../data/services";
import { caseStudy } from "../data/case-study";
---

<Base>
  <Header />
  <main id="main">
    <section class="hero" aria-labelledby="hero-heading">
      <div class="wrap hero__grid">
        <div class="hero__copy">
          <p class="eyebrow reveal">{site.eyebrow}</p>
          <h1 id="hero-heading" class="reveal reveal--delay-1">{site.headline}</h1>
          <p class="hero__tagline reveal reveal--delay-1">{site.displayTagline}</p>
          <p class="lede reveal reveal--delay-2">{site.intro}</p>
          <p class="hero__claim reveal reveal--delay-3">{site.claim}</p>
          <p class="hero__author reveal reveal--delay-3">
            <span class="hero__author-label">{site.authorLabel}</span>
            {site.author}
          </p>
          <div class="hero__actions reveal reveal--delay-4">
            <a class="button button--primary" href="#services">View services</a>
            <a class="button button--ghost" href={site.contactMailto}>Contact</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="services" aria-labelledby="services-heading">
      <div class="wrap">
        <div class="section__head">
          <p class="section__kicker">{servicesIntro.kicker}</p>
          <h2 id="services-heading">{servicesIntro.heading}</h2>
          <p class="section__intro">{servicesIntro.lead}</p>
        </div>

        <p class="split-note" role="note">
          <strong>Human / AI split.</strong>
          {servicesIntro.humanAi}
        </p>

        <ol class="service-list">
          {
            services.map((service, index) => (
              <li class="service">
                <span class="service__index" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div class="service__body">
                  <h3>{service.name}</h3>
                  <p class="service__do">
                    <span class="service__label">What we do</span>
                    {service.whatWeDo}
                  </p>
                  <p class="service__outcome">
                    <span class="service__label">Outcome you can check</span>
                    {service.outcome}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="audience">
          <div>
            <h3>Who it’s for</h3>
            <p>{audience.primary}</p>
          </div>
          <div>
            <h3>Not targeting</h3>
            <p>{audience.notTargeting}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="proof" aria-labelledby="proof-heading">
      <div class="wrap">
        <div class="section__head">
          <p class="section__kicker">Proof / process</p>
          <h2 id="proof-heading">{proof.heading}</h2>
          <p class="section__intro">{proof.intro}</p>
        </div>
        <div class="principles">
          {
            proof.principles.map((principle) => (
              <article class="principle">
                <h3>{principle.title}</h3>
                <p>{principle.body}</p>
              </article>
            ))
          }
        </div>
        <aside class="case-study-callout" aria-labelledby="case-study-callout-heading">
          <p class="section__kicker">Case study</p>
          <h3 id="case-study-callout-heading">{caseStudy.homepageLink.label}</h3>
          <p>{caseStudy.homepageLink.blurb}</p>
          <p>
            <a class="card__link" href={caseStudy.path}>
              Open the AESD case study <span aria-hidden="true">→</span>
            </a>
          </p>
        </aside>
        <p class="proof-source">
          Engineering source of truth:
          {" "}
          <a href={site.sourceUrl} rel="noopener noreferrer">{site.sourceLabel}</a>
        </p>
      </div>
    </section>

    <section class="section section--teaser" id="showcase" aria-labelledby="showcase-heading">
      <div class="wrap">
        <div class="teaser">
          <div class="teaser__meta">
            <p class="section__kicker">{teaser.kicker}</p>
            <div class="teaser__status" role="status">
              <span class="status-badge">{teaser.status}</span>
              <span class="status-detail">{teaser.statusDetail}</span>
            </div>
          </div>
          <h2 id="showcase-heading">{teaser.title}</h2>
          <p class="teaser__concept">{teaser.concept}</p>
          <p class="teaser__stack">
            <span class="service__label">Stack</span>
            {teaser.stack}
          </p>
          <p class="teaser__honesty">{teaser.honesty}</p>
        </div>
      </div>
    </section>

    <section class="section section--secondary" id="demos" aria-labelledby="demos-heading">
      <div class="wrap">
        <div class="section__head">
          <p class="section__kicker">{demosSection.kicker}</p>
          <h2 id="demos-heading">{demosSection.heading}</h2>
          <p class="section__intro">{demosSection.intro}</p>
        </div>
        <div class="demo-grid demo-grid--secondary">
          {demos.map((demo) => <DemoCard demo={demo} />)}
        </div>
      </div>
    </section>

    <section class="section" id="contact" aria-labelledby="contact-heading">
      <div class="wrap">
        <div class="section__head">
          <p class="section__kicker">Contact</p>
          <h2 id="contact-heading">Email only</h2>
          <p class="section__intro">
            Public contact is a single address. Use it for project conversations,
            engineering questions, and anything that should reach Gocklkatz Inc.
          </p>
        </div>
        <div class="contact-panel">
          <p>
            <a href={site.contactMailto}>{site.contactEmail}</a>
          </p>
          <p class="section__intro">
            mailto is enough — there is no form on this site and no other public inbox.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
